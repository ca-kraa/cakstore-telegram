{
  "info": {
    "name": "CAKSTORE Direct Digital Store REST API",
    "_postman_id": "cakstore-api-collection-v2",
    "description": "Official REST API collection for CAKSTORE marketplace. Includes products, orders, child item variants, currencies, categories, and administrator management.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "x-api-key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{API_KEY}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "https://store.cakwe.id",
      "type": "string"
    },
    {
      "key": "API_KEY",
      "value": "cks_YOUR_KEY_HERE",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Products & Catalog",
      "item": [
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/products?status=active&page=1&per_page=10",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "active"
                },
                {
                  "key": "category",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "10"
                }
              ]
            },
            "description": "Fetch paginated catalog of digital products."
          }
        },
        {
          "name": "Get Single Product",
          "request": {
            "method": "GET",
            "header": [],
